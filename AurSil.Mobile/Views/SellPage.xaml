<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AurSil.Mobile.Views.SellPage"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

	<Grid RowDefinitions="*,Auto">
		<ScrollView>
			<VerticalStackLayout>
				<Grid BackgroundColor="{StaticResource Navy}" Padding="20,26,20,52" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">
					<Label Text="←" TextColor="White" FontSize="26">
						<Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Label.GestureRecognizers>
					</Label>
					<Label x:Name="TitleLabel" Grid.Column="1" Text="Sell Gold" TextColor="White" FontSize="22" FontAttributes="Bold" Margin="12,0,0,0" />
					<Label x:Name="RateLabel" Grid.Row="1" Grid.ColumnSpan="2" Text="--" TextColor="{StaticResource Gold}" FontSize="30" FontAttributes="Bold" Margin="0,16,0,0" />
					<Label Grid.Row="2" Grid.ColumnSpan="2" Text="Live sell price per gram" TextColor="#AEB8CC" FontSize="12" />
				</Grid>

				<Border Margin="18,-34,18,16" Padding="18" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20">
					<Border.Shadow><Shadow Brush="Black" Opacity="0.12" Radius="18" Offset="0,6" /></Border.Shadow>
					<VerticalStackLayout Spacing="14">
						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Available to sell" TextColor="{StaticResource TextMuted}" />
							<Label x:Name="AvailableLabel" Grid.Column="1" Text="0 g" TextColor="{StaticResource Navy}" FontAttributes="Bold" />
						</Grid>

						<Border Style="{StaticResource FieldBorder}" HeightRequest="64">
							<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
								<Entry x:Name="GramsEntry" Placeholder="0" Keyboard="Numeric" FontSize="26" TextColor="{StaticResource Navy}"
								       BackgroundColor="Transparent" VerticalOptions="Center" TextChanged="OnGramsChanged" />
								<Label Grid.Column="1" Text="g" FontSize="18" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
								<Label Grid.Column="2" Text="SELL ALL" Style="{StaticResource LinkLabel}" FontSize="12" VerticalOptions="Center">
									<Label.GestureRecognizers><TapGestureRecognizer Tapped="OnSellAllTapped" /></Label.GestureRecognizers>
								</Label>
							</Grid>
						</Border>

						<Grid ColumnDefinitions="*,Auto">
							<Label Text="You will receive" TextColor="{StaticResource Navy}" FontSize="16" FontAttributes="Bold" />
							<Label x:Name="ReceiveLabel" Grid.Column="1" Text="₹0.00" TextColor="#15803D" FontSize="20" FontAttributes="Bold" />
						</Grid>

						<!-- Payout bank -->
						<Border BackgroundColor="#F8FAFC" Stroke="#E5E7EB" StrokeShape="RoundRectangle 14" Padding="14">
							<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBankTapped" /></Border.GestureRecognizers>
							<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
								<Label Text="🏦" FontSize="26" VerticalOptions="Center" />
								<VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
									<Label Text="Money will be sent to" TextColor="{StaticResource TextMuted}" FontSize="12" />
									<Label x:Name="BankLabel" Text="Add bank account" TextColor="{StaticResource Navy}" FontAttributes="Bold" />
								</VerticalStackLayout>
								<Label Grid.Column="2" x:Name="BankAction" Text="Add ›" Style="{StaticResource LinkLabel}" VerticalOptions="Center" />
							</Grid>
						</Border>

						<Label x:Name="ErrorLabel" TextColor="{StaticResource ErrorRed}" FontSize="13" IsVisible="False" />
						<Label Text="Amount is credited to your bank account (test mode: payout is simulated)." FontSize="12"
						       TextColor="{StaticResource TextMuted}" />
					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>
		</ScrollView>

		<Grid Grid.Row="1" Padding="18,10,18,14" BackgroundColor="White">
			<Button x:Name="SellButton" Text="Sell" Style="{StaticResource GoldButton}" Clicked="OnSellClicked" />
			<ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" Color="{StaticResource Navy}"
			                   HorizontalOptions="Center" VerticalOptions="Center" />
		</Grid>
	</Grid>
</ContentPage>
