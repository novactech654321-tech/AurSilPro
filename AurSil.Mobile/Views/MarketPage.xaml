<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AurSil.Mobile.Views"
             x:Class="AurSil.Mobile.Views.MarketPage"
             BackgroundColor="{StaticResource Navy}"
             Shell.NavBarIsVisible="False">

	<ContentPage.Resources>
		<Style x:Key="Seg" TargetType="Border">
			<Setter Property="StrokeThickness" Value="0" />
			<Setter Property="StrokeShape" Value="RoundRectangle 12" />
			<Setter Property="BackgroundColor" Value="#22FFFFFF" />
			<Setter Property="HeightRequest" Value="40" />
		</Style>
		<Style x:Key="SegLabel" TargetType="Label">
			<Setter Property="TextColor" Value="White" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="HorizontalTextAlignment" Value="Center" />
			<Setter Property="VerticalTextAlignment" Value="Center" />
		</Style>
		<Style x:Key="Chip" TargetType="Border">
			<Setter Property="StrokeThickness" Value="0" />
			<Setter Property="StrokeShape" Value="RoundRectangle 10" />
			<Setter Property="BackgroundColor" Value="#22FFFFFF" />
			<Setter Property="HeightRequest" Value="34" />
		</Style>
	</ContentPage.Resources>

	<Grid RowDefinitions="*,Auto">
		<RefreshView x:Name="Refresher" Refreshing="OnRefreshing" RefreshColor="{StaticResource Gold}">
			<ScrollView>
				<VerticalStackLayout Padding="16,22,16,16" Spacing="16">
					<Label Text="Market" TextColor="White" FontSize="26" FontAttributes="Bold" />

					<Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
						<Border x:Name="SegGold" Style="{StaticResource Seg}" BackgroundColor="{StaticResource Gold}">
							<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMetalTapped" CommandParameter="gold" /></Border.GestureRecognizers>
							<Label Text="Gold" Style="{StaticResource SegLabel}" TextColor="{StaticResource Navy}" FontAttributes="Bold" />
						</Border>
						<Border x:Name="SegSilver" Grid.Column="1" Style="{StaticResource Seg}">
							<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMetalTapped" CommandParameter="silver" /></Border.GestureRecognizers>
							<Label Text="Silver" Style="{StaticResource SegLabel}" />
						</Border>
						<Border x:Name="SegPlatinum" Grid.Column="2" Style="{StaticResource Seg}">
							<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMetalTapped" CommandParameter="platinum" /></Border.GestureRecognizers>
							<Label Text="Platinum" Style="{StaticResource SegLabel}" />
						</Border>
					</Grid>

					<Border BackgroundColor="{StaticResource NavyLight}" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
						<VerticalStackLayout Spacing="12">
							<Grid ColumnDefinitions="*,Auto">
								<VerticalStackLayout>
									<Label x:Name="MetalTitle" Text="Gold (24K, 99.9%)" TextColor="#AEB8CC" FontSize="13" />
									<Label x:Name="BuyRateLabel" Text="--" TextColor="White" FontSize="30" FontAttributes="Bold" />
									<Label Text="per gram • buy price (excl. GST)" TextColor="#8A97B0" FontSize="11" />
								</VerticalStackLayout>
								<Border Grid.Column="1" x:Name="ChangeBadge" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4"
								        BackgroundColor="#2216A34A" VerticalOptions="Start">
									<Label x:Name="ChangeLabel" Text="" FontSize="13" FontAttributes="Bold" TextColor="#16A34A" />
								</Border>
							</Grid>

							<GraphicsView x:Name="Chart" HeightRequest="200">
								<GraphicsView.Drawable>
									<views:PriceTrendDrawable x:Name="ChartDrawable" />
								</GraphicsView.Drawable>
							</GraphicsView>

							<Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
								<Border x:Name="Chip1D" Style="{StaticResource Chip}" BackgroundColor="{StaticResource Gold}">
									<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRangeTapped" CommandParameter="1D" /></Border.GestureRecognizers>
									<Label Text="1D" Style="{StaticResource SegLabel}" TextColor="{StaticResource Navy}" FontAttributes="Bold" />
								</Border>
								<Border x:Name="Chip1W" Grid.Column="1" Style="{StaticResource Chip}">
									<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRangeTapped" CommandParameter="1W" /></Border.GestureRecognizers>
									<Label Text="1W" Style="{StaticResource SegLabel}" />
								</Border>
								<Border x:Name="Chip1M" Grid.Column="2" Style="{StaticResource Chip}">
									<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRangeTapped" CommandParameter="1M" /></Border.GestureRecognizers>
									<Label Text="1M" Style="{StaticResource SegLabel}" />
								</Border>
								<Border x:Name="Chip1Y" Grid.Column="3" Style="{StaticResource Chip}">
									<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRangeTapped" CommandParameter="1Y" /></Border.GestureRecognizers>
									<Label Text="1Y" Style="{StaticResource SegLabel}" />
								</Border>
							</Grid>
							<Label x:Name="RangeLabel" Text="" TextColor="#8A97B0" FontSize="12" HorizontalOptions="Center" />
						</VerticalStackLayout>
					</Border>

					<Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16">
						<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
							<Label Text="Price details" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Navy}" Grid.ColumnSpan="2" />
							<Label Grid.Row="1" Text="Buy price / g" TextColor="{StaticResource TextMuted}" />
							<Label Grid.Row="1" Grid.Column="1" x:Name="BuyDetail" Text="--" TextColor="{StaticResource Navy}" FontAttributes="Bold" />
							<Label Grid.Row="2" Text="Sell price / g" TextColor="{StaticResource TextMuted}" />
							<Label Grid.Row="2" Grid.Column="1" x:Name="SellDetail" Text="--" TextColor="{StaticResource Navy}" FontAttributes="Bold" />
							<Label Grid.Row="3" Text="International spot" TextColor="{StaticResource TextMuted}" />
							<Label Grid.Row="3" Grid.Column="1" x:Name="SpotDetail" Text="--" TextColor="{StaticResource Navy}" />
							<Label Grid.Row="4" Text="USD / INR" TextColor="{StaticResource TextMuted}" />
							<Label Grid.Row="4" Grid.Column="1" x:Name="FxDetail" Text="--" TextColor="{StaticResource Navy}" />
						</Grid>
					</Border>
					<Label x:Name="UpdatedLabel" Text="" TextColor="#8A97B0" FontSize="12" HorizontalOptions="Center" />
				</VerticalStackLayout>
			</ScrollView>
		</RefreshView>

		<Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="16,10,16,12" BackgroundColor="{StaticResource Navy}">
			<Button Text="Sell" Clicked="OnSellClicked" BackgroundColor="Transparent" BorderColor="{StaticResource Gold}" BorderWidth="2"
			        TextColor="{StaticResource Gold}" FontAttributes="Bold" FontSize="16" CornerRadius="12" HeightRequest="52" />
			<Button Grid.Column="1" Text="Buy" Clicked="OnBuyClicked" Style="{StaticResource GoldButton}" />
		</Grid>
	</Grid>
</ContentPage>
