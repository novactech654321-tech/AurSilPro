<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AurSil.Mobile.Views.BankPage"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

	<ScrollView>
		<VerticalStackLayout>
			<Grid BackgroundColor="{StaticResource Navy}" Padding="20,28,20,56" ColumnDefinitions="Auto,*">
				<Label Text="←" TextColor="White" FontSize="26" VerticalOptions="Start">
					<Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Label.GestureRecognizers>
				</Label>
				<VerticalStackLayout Grid.Column="1" Spacing="4" Margin="12,0,0,0">
					<Label Text="Bank Account" TextColor="White" FontSize="24" FontAttributes="Bold" />
					<Label Text="Sale proceeds are paid to this account" TextColor="#AEB8CC" FontSize="13" />
				</VerticalStackLayout>
			</Grid>

			<Border Margin="20,-34,20,20" Padding="22" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20">
				<Border.Shadow><Shadow Brush="Black" Opacity="0.12" Radius="18" Offset="0,6" /></Border.Shadow>
				<VerticalStackLayout Spacing="12">

					<Border x:Name="CurrentCard" IsVisible="False" Background="{StaticResource GoldBrush}" StrokeThickness="0"
					        StrokeShape="RoundRectangle 14" Padding="16">
						<VerticalStackLayout Spacing="2">
							<Label Text="LINKED ACCOUNT" TextColor="{StaticResource Navy}" FontSize="11" FontAttributes="Bold" />
							<Label x:Name="CurrentBank" Text="" TextColor="{StaticResource Navy}" FontSize="18" FontAttributes="Bold" />
							<Label x:Name="CurrentNumber" Text="" TextColor="{StaticResource Navy}" FontSize="15" />
							<Label x:Name="CurrentHolder" Text="" TextColor="#3B2F10" FontSize="13" />
						</VerticalStackLayout>
					</Border>
					<Label x:Name="FormTitle" Text="Add your bank account" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Navy}" />

					<VerticalStackLayout>
						<Label Text="Account Holder Name" Style="{StaticResource FieldLabel}" />
						<Border Style="{StaticResource FieldBorder}">
							<Entry x:Name="HolderEntry" Placeholder="As per bank records" Style="{StaticResource FieldEntry}" />
						</Border>
					</VerticalStackLayout>
					<VerticalStackLayout>
						<Label Text="Account Number" Style="{StaticResource FieldLabel}" />
						<Border Style="{StaticResource FieldBorder}">
							<Entry x:Name="AccountEntry" Placeholder="9 to 18 digits" Style="{StaticResource FieldEntry}" Keyboard="Numeric"
							       MaxLength="18" IsPassword="True" />
						</Border>
					</VerticalStackLayout>
					<VerticalStackLayout>
						<Label Text="Confirm Account Number" Style="{StaticResource FieldLabel}" />
						<Border Style="{StaticResource FieldBorder}">
							<Entry x:Name="ConfirmEntry" Placeholder="Re-enter account number" Style="{StaticResource FieldEntry}"
							       Keyboard="Numeric" MaxLength="18" />
						</Border>
					</VerticalStackLayout>
					<VerticalStackLayout>
						<Label Text="IFSC Code" Style="{StaticResource FieldLabel}" />
						<Border Style="{StaticResource FieldBorder}">
							<Entry x:Name="IfscEntry" Placeholder="e.g. HDFC0001234" Style="{StaticResource FieldEntry}" MaxLength="11"
							       TextTransform="Uppercase" TextChanged="OnIfscChanged" />
						</Border>
						<Label x:Name="IfscInfoLabel" Text="" FontSize="12" TextColor="#15803D" Margin="4,4,0,0" IsVisible="False" />
					</VerticalStackLayout>

					<Label x:Name="ErrorLabel" TextColor="{StaticResource ErrorRed}" FontSize="13" IsVisible="False" />

					<Grid Margin="0,4,0,0">
						<Button x:Name="SaveButton" Text="Save Bank Account" Style="{StaticResource GoldButton}" Clicked="OnSaveClicked" />
						<ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" Color="{StaticResource Navy}"
						                   HorizontalOptions="Center" VerticalOptions="Center" />
					</Grid>
					<Label Text="🔒 Your account number is stored securely and shown masked." FontSize="12" TextColor="{StaticResource TextMuted}" />
				</VerticalStackLayout>
			</Border>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
