<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AurSil.Mobile.Views.LoginPage"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False">

	<ScrollView>
		<VerticalStackLayout>

			<!-- Brand header -->
			<Grid BackgroundColor="{StaticResource Navy}" Padding="24,40,24,60">
				<VerticalStackLayout Spacing="6" HorizontalOptions="Center">
					<Image Source="logo.png" WidthRequest="72" HeightRequest="72" />
					<Label HorizontalOptions="Center" FontSize="30" FontAttributes="Bold">
						<Label.FormattedText>
							<FormattedString>
								<Span Text="Aur" TextColor="{StaticResource Gold}" />
								<Span Text="Sil" TextColor="{StaticResource SilverTone}" />
							</FormattedString>
						</Label.FormattedText>
					</Label>
					<Label Text="Invest  |  Grow  |  Secure" TextColor="#AEB8CC" FontSize="13" HorizontalOptions="Center" />
				</VerticalStackLayout>
				<Label Text="⚙" TextColor="#5E6E8C" FontSize="20" HorizontalOptions="End" VerticalOptions="Start">
					<Label.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnServerSettingsTapped" />
					</Label.GestureRecognizers>
				</Label>
			</Grid>

			<!-- Login card -->
			<Border Margin="20,-36,20,20" Padding="22" BackgroundColor="White" StrokeThickness="0"
			        StrokeShape="RoundRectangle 20">
				<Border.Shadow>
					<Shadow Brush="Black" Opacity="0.12" Radius="18" Offset="0,6" />
				</Border.Shadow>
				<VerticalStackLayout Spacing="14">
					<Label Text="Welcome back!" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
					<Label Text="Log in to continue investing" FontSize="14" TextColor="{StaticResource TextMuted}" Margin="0,-10,0,4" />

					<VerticalStackLayout>
						<Label Text="User ID or Email" Style="{StaticResource FieldLabel}" />
						<Border Style="{StaticResource FieldBorder}">
							<Entry x:Name="LoginEntry" Placeholder="Enter User ID or Email" Style="{StaticResource FieldEntry}"
							       Keyboard="Email" ReturnType="Next" />
						</Border>
					</VerticalStackLayout>

					<VerticalStackLayout>
						<Label Text="Password" Style="{StaticResource FieldLabel}" />
						<Border Style="{StaticResource FieldBorder}">
							<Grid ColumnDefinitions="*,Auto">
								<Entry x:Name="PasswordEntry" Placeholder="Enter password" IsPassword="True"
								       Style="{StaticResource FieldEntry}" ReturnType="Go" Completed="OnLoginClicked" />
								<Label x:Name="ShowPassword" Grid.Column="1" Text="Show" Style="{StaticResource LinkLabel}"
								       VerticalOptions="Center" FontSize="13">
									<Label.GestureRecognizers>
										<TapGestureRecognizer Tapped="OnTogglePassword" />
									</Label.GestureRecognizers>
								</Label>
							</Grid>
						</Border>
					</VerticalStackLayout>

					<Label Text="Forgot password?" Style="{StaticResource LinkLabel}" HorizontalOptions="End">
						<Label.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnForgotTapped" />
						</Label.GestureRecognizers>
					</Label>

					<Label x:Name="ErrorLabel" TextColor="{StaticResource ErrorRed}" FontSize="13" IsVisible="False" />

					<Grid>
						<Button x:Name="LoginButton" Text="Login" Style="{StaticResource GoldButton}" Clicked="OnLoginClicked" />
						<ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" Color="{StaticResource Navy}"
						                   HorizontalOptions="Center" VerticalOptions="Center" />
					</Grid>

					<HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,6,0,0">
						<Label Text="New to AurSil?" TextColor="{StaticResource TextMuted}" FontSize="14" />
						<Label Text="Register" Style="{StaticResource LinkLabel}">
							<Label.GestureRecognizers>
								<TapGestureRecognizer Tapped="OnRegisterTapped" />
							</Label.GestureRecognizers>
						</Label>
					</HorizontalStackLayout>
				</VerticalStackLayout>
			</Border>

			<Label Text="🔒  Your data is protected with secure encryption" TextColor="{StaticResource TextMuted}"
			       FontSize="12" HorizontalOptions="Center" Margin="0,0,0,24" />
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
