<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AurSil.Mobile.Views"
             xmlns:svc="clr-namespace:AurSil.Mobile.Services"
             x:Class="AurSil.Mobile.Views.HomePage"
             BackgroundColor="{StaticResource Navy}"
             Shell.NavBarIsVisible="False">

	<ContentPage.Resources>
		<Style x:Key="MetalCard" TargetType="Border">
			<Setter Property="StrokeThickness" Value="0" />
			<Setter Property="StrokeShape" Value="RoundRectangle 14" />
			<Setter Property="Padding" Value="8,12" />
			<Setter Property="HeightRequest" Value="150" />
		</Style>
		<Style x:Key="LoanTile" TargetType="Border">
			<Setter Property="BackgroundColor" Value="White" />
			<Setter Property="Stroke" Value="#E5E7EB" />
			<Setter Property="StrokeShape" Value="RoundRectangle 12" />
			<Setter Property="Padding" Value="4,12" />
		</Style>
		<Style x:Key="OffBadge" TargetType="Label">
			<Setter Property="IsVisible" Value="False" />
			<Setter Property="BackgroundColor" Value="#DC2626" />
			<Setter Property="TextColor" Value="White" />
			<Setter Property="FontSize" Value="10" />
			<Setter Property="FontAttributes" Value="Bold" />
			<Setter Property="Padding" Value="5,1" />
			<Setter Property="HorizontalOptions" Value="End" />
			<Setter Property="VerticalOptions" Value="Start" />
		</Style>
		<Style x:Key="ChipLabel" TargetType="Label">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="TextColor" Value="White" />
			<Setter Property="HorizontalTextAlignment" Value="Center" />
			<Setter Property="VerticalTextAlignment" Value="Center" />
		</Style>
	</ContentPage.Resources>

	<RefreshView x:Name="Refresher" Refreshing="OnRefreshing" RefreshColor="{StaticResource Gold}">
		<ScrollView>
			<VerticalStackLayout Padding="16,18,16,20" Spacing="16">

				<!-- Header -->
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
					<Image Source="logo.png" WidthRequest="44" HeightRequest="44" />
					<VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
						<Label FontSize="24" FontAttributes="Bold">
							<Label.FormattedText>
								<FormattedString>
									<Span Text="Aur" TextColor="{StaticResource Gold}" />
									<Span Text="Sil" TextColor="{StaticResource SilverTone}" />
								</FormattedString>
							</Label.FormattedText>
						</Label>
						<Label Text="Invest  |  Grow  |  Secure" TextColor="#AEB8CC" FontSize="11" />
					</VerticalStackLayout>
					<Label Grid.Column="2" Text="🔔" FontSize="22" VerticalOptions="Center">
						<Label.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnComingSoon" CommandParameter="Price alerts" />
						</Label.GestureRecognizers>
					</Label>
				</Grid>

				<VerticalStackLayout Spacing="2">
					<Label x:Name="WelcomeLabel" Text="Welcome!" TextColor="White" FontSize="24" FontAttributes="Bold" />
					<Label Text="Invest in your future today." TextColor="#AEB8CC" FontSize="15" />
				</VerticalStackLayout>

				<!-- Offers published by the admin -->
				<VerticalStackLayout x:Name="OfferList" Spacing="10" IsVisible="False">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="svc:OfferDto">
							<Border StrokeThickness="1" Stroke="#F5B82E" StrokeShape="RoundRectangle 16" BackgroundColor="#1F3A63" Padding="14,12">
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
									<Label Text="🎁" FontSize="26" VerticalOptions="Center" />
									<VerticalStackLayout Grid.Column="1" Spacing="2">
										<Label Text="{Binding Title}" TextColor="{StaticResource Gold}" FontSize="15" FontAttributes="Bold" />
										<Label Text="{Binding Message}" TextColor="White" FontSize="13" />
									</VerticalStackLayout>
								</Grid>
							</Border>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>

				<!-- Portfolio summary -->
				<Border StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="18" Background="{StaticResource GoldBrush}">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnPortfolioTapped" />
					</Border.GestureRecognizers>
					<Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
						<Label Text="Your Portfolio Value" TextColor="{StaticResource Navy}" FontSize="13" />
						<Label Grid.Column="1" Text="View ›" TextColor="{StaticResource Navy}" FontSize="13" FontAttributes="Bold" />
						<Label x:Name="PortfolioValue" Grid.Row="1" Text="₹0.00" TextColor="{StaticResource Navy}" FontSize="30" FontAttributes="Bold" />
						<HorizontalStackLayout Grid.Row="2" Spacing="14">
							<Label x:Name="PortfolioInvested" Text="Invested ₹0.00" TextColor="#3B2F10" FontSize="13" />
							<Label x:Name="PortfolioPl" Text="" FontSize="13" FontAttributes="Bold" />
						</HorizontalStackLayout>
					</Grid>
				</Border>

				<!-- Live prices -->
				<Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14">
					<VerticalStackLayout Spacing="12">
						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Invest in Precious Metals" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
							<HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
								<Ellipse Fill="#16A34A" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
								<Label x:Name="UpdatedLabel" Text="LIVE" FontSize="11" TextColor="{StaticResource TextMuted}" />
							</HorizontalStackLayout>
						</Grid>
						<Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
							<Border Style="{StaticResource MetalCard}" Background="{StaticResource GoldBrush}">
								<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBuyTapped" CommandParameter="gold" /></Border.GestureRecognizers>
								<Grid RowDefinitions="*,Auto,Auto,Auto,Auto">
									<Label Text="Au" FontSize="28" FontAttributes="Bold" TextColor="#FFF6D8" HorizontalOptions="Center" VerticalOptions="Center" />
									<Label Grid.Row="1" Text="Gold" FontSize="16" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
									<Label x:Name="GoldOff" Style="{StaticResource OffBadge}" />
									<Label x:Name="GoldRate" Grid.Row="2" Text="--" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
									<Label x:Name="GoldChange" Grid.Row="3" Text="" FontSize="11" TextColor="White" HorizontalOptions="Center" />
									<Label Grid.Row="4" Text="Buy Now ›" FontSize="11" TextColor="White" HorizontalOptions="Center" Margin="0,2,0,0" />
								</Grid>
							</Border>
							<Border Grid.Column="1" Style="{StaticResource MetalCard}" Background="{StaticResource SilverBrush}">
								<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBuyTapped" CommandParameter="silver" /></Border.GestureRecognizers>
								<Grid RowDefinitions="*,Auto,Auto,Auto,Auto">
									<Label Text="Ag" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
									<Label Grid.Row="1" Text="Silver" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Navy}" HorizontalOptions="Center" />
									<Label x:Name="SilverOff" Style="{StaticResource OffBadge}" />
									<Label x:Name="SilverRate" Grid.Row="2" Text="--" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Navy}" HorizontalOptions="Center" />
									<Label x:Name="SilverChange" Grid.Row="3" Text="" FontSize="11" TextColor="{StaticResource Navy}" HorizontalOptions="Center" />
									<Label Grid.Row="4" Text="Buy Now ›" FontSize="11" TextColor="{StaticResource Navy}" HorizontalOptions="Center" Margin="0,2,0,0" />
								</Grid>
							</Border>
							<Border Grid.Column="2" Style="{StaticResource MetalCard}" Background="{StaticResource PlatinumBrush}">
								<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBuyTapped" CommandParameter="platinum" /></Border.GestureRecognizers>
								<Grid RowDefinitions="*,Auto,Auto,Auto,Auto">
									<Label Text="Pt" FontSize="28" FontAttributes="Bold" TextColor="#E4DCFF" HorizontalOptions="Center" VerticalOptions="Center" />
									<Label Grid.Row="1" Text="Platinum" FontSize="16" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
									<Label x:Name="PlatinumOff" Style="{StaticResource OffBadge}" />
									<Label x:Name="PlatinumRate" Grid.Row="2" Text="--" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
									<Label x:Name="PlatinumChange" Grid.Row="3" Text="" FontSize="11" TextColor="White" HorizontalOptions="Center" />
									<Label Grid.Row="4" Text="Buy Now ›" FontSize="11" TextColor="White" HorizontalOptions="Center" Margin="0,2,0,0" />
								</Grid>
							</Border>
						</Grid>
						<Label Text="Live price per gram (excl. 3% GST)" FontSize="11" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
					</VerticalStackLayout>
				</Border>

				<!-- Market price trends -->
				<Border BackgroundColor="{StaticResource NavyLight}" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14">
					<VerticalStackLayout Spacing="10">
						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Market Price Trends" FontSize="17" FontAttributes="Bold" TextColor="White" />
							<Label Grid.Column="1" Text="Details ›" FontSize="13" TextColor="{StaticResource Gold}" VerticalOptions="Center">
								<Label.GestureRecognizers><TapGestureRecognizer Tapped="OnMarketTapped" /></Label.GestureRecognizers>
							</Label>
						</Grid>
						<Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" HeightRequest="30">
							<Border x:Name="TabGold" StrokeThickness="1" Stroke="#F5B82E" StrokeShape="RoundRectangle 10" BackgroundColor="#33F5B82E">
								<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChartMetalTapped" CommandParameter="gold" /></Border.GestureRecognizers>
								<Label Text="● Gold" Style="{StaticResource ChipLabel}" TextColor="#F5B82E" />
							</Border>
							<Border x:Name="TabSilver" Grid.Column="1" StrokeThickness="1" Stroke="#33FFFFFF" StrokeShape="RoundRectangle 10">
								<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChartMetalTapped" CommandParameter="silver" /></Border.GestureRecognizers>
								<Label Text="● Silver" Style="{StaticResource ChipLabel}" TextColor="#C0C7D1" />
							</Border>
							<Border x:Name="TabPlatinum" Grid.Column="2" StrokeThickness="1" Stroke="#33FFFFFF" StrokeShape="RoundRectangle 10">
								<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChartMetalTapped" CommandParameter="platinum" /></Border.GestureRecognizers>
								<Label Text="● Platinum" Style="{StaticResource ChipLabel}" TextColor="#A78BFA" />
							</Border>
						</Grid>
						<GraphicsView x:Name="Chart" HeightRequest="140">
							<GraphicsView.Drawable>
								<views:PriceTrendDrawable x:Name="ChartDrawable" />
							</GraphicsView.Drawable>
						</GraphicsView>
						<Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8" HeightRequest="32">
							<Border x:Name="Chip1D" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource Gold}">
								<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRangeTapped" CommandParameter="1D" /></Border.GestureRecognizers>
								<Label Text="1D" Style="{StaticResource ChipLabel}" TextColor="{StaticResource Navy}" FontAttributes="Bold" />
							</Border>
							<Border x:Name="Chip1W" Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="#22FFFFFF">
								<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRangeTapped" CommandParameter="1W" /></Border.GestureRecognizers>
								<Label Text="1W" Style="{StaticResource ChipLabel}" />
							</Border>
							<Border x:Name="Chip1M" Grid.Column="2" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="#22FFFFFF">
								<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRangeTapped" CommandParameter="1M" /></Border.GestureRecognizers>
								<Label Text="1M" Style="{StaticResource ChipLabel}" />
							</Border>
							<Border x:Name="Chip1Y" Grid.Column="3" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="#22FFFFFF">
								<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRangeTapped" CommandParameter="1Y" /></Border.GestureRecognizers>
								<Label Text="1Y" Style="{StaticResource ChipLabel}" />
							</Border>
						</Grid>
					</VerticalStackLayout>
				</Border>

				<!-- Loan options -->
				<Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14">
					<VerticalStackLayout Spacing="12">
						<VerticalStackLayout>
							<Label Text="Loan Options" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
							<Label Text="Explore secured loans when needed." FontSize="13" TextColor="{StaticResource TextMuted}" />
						</VerticalStackLayout>
						<Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
							<Border Style="{StaticResource LoanTile}">
								<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnComingSoon" CommandParameter="Personal Loan" /></Border.GestureRecognizers>
								<VerticalStackLayout Spacing="4">
									<Label Text="🏠" FontSize="24" HorizontalOptions="Center" />
									<Label Text="Personal&#10;Loan" FontSize="12" TextColor="{StaticResource Navy}" HorizontalTextAlignment="Center" />
								</VerticalStackLayout>
							</Border>
							<Border Grid.Column="1" Style="{StaticResource LoanTile}">
								<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnComingSoon" CommandParameter="Vehicle Loan" /></Border.GestureRecognizers>
								<VerticalStackLayout Spacing="4">
									<Label Text="🚗" FontSize="24" HorizontalOptions="Center" />
									<Label Text="Vehicle&#10;Loan" FontSize="12" TextColor="{StaticResource Navy}" HorizontalTextAlignment="Center" />
								</VerticalStackLayout>
							</Border>
							<Border Grid.Column="2" Style="{StaticResource LoanTile}">
								<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnComingSoon" CommandParameter="Education Loan" /></Border.GestureRecognizers>
								<VerticalStackLayout Spacing="4">
									<Label Text="🎓" FontSize="24" HorizontalOptions="Center" />
									<Label Text="Education&#10;Loan" FontSize="12" TextColor="{StaticResource Navy}" HorizontalTextAlignment="Center" />
								</VerticalStackLayout>
							</Border>
							<Border Grid.Column="3" Style="{StaticResource LoanTile}">
								<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnComingSoon" CommandParameter="Business Loan" /></Border.GestureRecognizers>
								<VerticalStackLayout Spacing="4">
									<Label Text="💼" FontSize="24" HorizontalOptions="Center" />
									<Label Text="Business&#10;Loan" FontSize="12" TextColor="{StaticResource Navy}" HorizontalTextAlignment="Center" />
								</VerticalStackLayout>
							</Border>
						</Grid>
					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>
		</ScrollView>
	</RefreshView>
</ContentPage>
