<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AurSil.Mobile.Views.OtpPage"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False">

	<ScrollView>
		<VerticalStackLayout>

			<Grid BackgroundColor="{StaticResource Navy}" Padding="20,28,20,56" ColumnDefinitions="Auto,*">
				<Label Text="←" TextColor="White" FontSize="26" VerticalOptions="Start">
					<Label.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnBackTapped" />
					</Label.GestureRecognizers>
				</Label>
				<VerticalStackLayout Grid.Column="1" Spacing="4" Margin="12,0,0,0">
					<Label Text="Verify Email" TextColor="White" FontSize="24" FontAttributes="Bold" />
					<Label Text="Enter the 6-digit code we emailed you" TextColor="#AEB8CC" FontSize="13" />
				</VerticalStackLayout>
			</Grid>

			<Border Margin="20,-34,20,20" Padding="22" BackgroundColor="White" StrokeThickness="0"
			        StrokeShape="RoundRectangle 20">
				<Border.Shadow>
					<Shadow Brush="Black" Opacity="0.12" Radius="18" Offset="0,6" />
				</Border.Shadow>
				<VerticalStackLayout Spacing="16">
					<Label HorizontalOptions="Center" HorizontalTextAlignment="Center" FontSize="22" Text="✉️" />
					<Label x:Name="SentToLabel" HorizontalTextAlignment="Center" TextColor="{StaticResource TextMuted}" FontSize="14" />

					<Border Style="{StaticResource FieldBorder}" HeightRequest="64">
						<Entry x:Name="CodeEntry" Placeholder="● ● ● ● ● ●" Keyboard="Numeric" MaxLength="6"
						       HorizontalTextAlignment="Center" FontSize="28" CharacterSpacing="10"
						       TextColor="{StaticResource Navy}" BackgroundColor="Transparent" VerticalOptions="Center"
						       TextChanged="OnCodeChanged" />
					</Border>

					<Label x:Name="ErrorLabel" TextColor="{StaticResource ErrorRed}" FontSize="13" IsVisible="False"
					       HorizontalTextAlignment="Center" />

					<Grid>
						<Button x:Name="VerifyButton" Text="Verify" Style="{StaticResource GoldButton}" Clicked="OnVerifyClicked" />
						<ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" Color="{StaticResource Navy}"
						                   HorizontalOptions="Center" VerticalOptions="Center" />
					</Grid>

					<HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
						<Label Text="Didn't get the code?" TextColor="{StaticResource TextMuted}" FontSize="14" />
						<Label x:Name="ResendLabel" Text="Resend OTP" Style="{StaticResource LinkLabel}">
							<Label.GestureRecognizers>
								<TapGestureRecognizer Tapped="OnResendTapped" />
							</Label.GestureRecognizers>
						</Label>
					</HorizontalStackLayout>
				</VerticalStackLayout>
			</Border>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
