<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AurSil.Mobile.Views.RegisterPage"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False">

	<ScrollView>
		<VerticalStackLayout>

			<Grid BackgroundColor="{StaticResource Navy}" Padding="20,28,20,56" ColumnDefinitions="Auto,*">
				<Label Text="←" TextColor="White" FontSize="26" VerticalOptions="Start">
					<Label.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnBackTapped" />
					</Label.GestureRecognizers>
				</Label>
				<VerticalStackLayout Grid.Column="1" Spacing="4" Margin="12,0,0,0">
					<Label Text="Create Account" TextColor="White" FontSize="24" FontAttributes="Bold" />
					<Label Text="Start investing in Gold, Silver and Platinum" TextColor="#AEB8CC" FontSize="13" />
				</VerticalStackLayout>
			</Grid>

			<Border Margin="20,-34,20,20" Padding="22" BackgroundColor="White" StrokeThickness="0"
			        StrokeShape="RoundRectangle 20">
				<Border.Shadow>
					<Shadow Brush="Black" Opacity="0.12" Radius="18" Offset="0,6" />
				</Border.Shadow>
				<VerticalStackLayout Spacing="12">

					<VerticalStackLayout>
						<Label Text="User ID" Style="{StaticResource FieldLabel}" />
						<Border Style="{StaticResource FieldBorder}">
							<Entry x:Name="UserIdEntry" Placeholder="e.g. suman_01" Style="{StaticResource FieldEntry}" />
						</Border>
					</VerticalStackLayout>

					<VerticalStackLayout>
						<Label Text="Full Name" Style="{StaticResource FieldLabel}" />
						<Border Style="{StaticResource FieldBorder}">
							<Entry x:Name="NameEntry" Placeholder="Enter your full name" Style="{StaticResource FieldEntry}"
							       Keyboard="Text" />
						</Border>
					</VerticalStackLayout>

					<VerticalStackLayout>
						<Label Text="Email" Style="{StaticResource FieldLabel}" />
						<Border Style="{StaticResource FieldBorder}">
							<Entry x:Name="EmailEntry" Placeholder="you@example.com" Style="{StaticResource FieldEntry}"
							       Keyboard="Email" />
						</Border>
					</VerticalStackLayout>

					<VerticalStackLayout>
						<Label Text="Mobile Number" Style="{StaticResource FieldLabel}" />
						<Border Style="{StaticResource FieldBorder}">
							<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
								<Label Text="+91" TextColor="{StaticResource Navy}" FontSize="16" VerticalOptions="Center" />
								<Entry x:Name="PhoneEntry" Grid.Column="1" Placeholder="10-digit mobile number"
								       Style="{StaticResource FieldEntry}" Keyboard="Telephone" MaxLength="10" />
							</Grid>
						</Border>
					</VerticalStackLayout>

					<VerticalStackLayout>
						<Label Text="Password" Style="{StaticResource FieldLabel}" />
						<Border Style="{StaticResource FieldBorder}">
							<Entry x:Name="PasswordEntry" Placeholder="Min 8 characters, letters + numbers"
							       Style="{StaticResource FieldEntry}" IsPassword="True" />
						</Border>
					</VerticalStackLayout>

					<VerticalStackLayout>
						<Label Text="Confirm Password" Style="{StaticResource FieldLabel}" />
						<Border Style="{StaticResource FieldBorder}">
							<Entry x:Name="ConfirmEntry" Placeholder="Re-enter password"
							       Style="{StaticResource FieldEntry}" IsPassword="True" />
						</Border>
					</VerticalStackLayout>

					<Label x:Name="ErrorLabel" TextColor="{StaticResource ErrorRed}" FontSize="13" IsVisible="False" />

					<Grid Margin="0,4,0,0">
						<Button x:Name="RegisterButton" Text="Register &amp; Send OTP" Style="{StaticResource GoldButton}"
						        Clicked="OnRegisterClicked" />
						<ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" Color="{StaticResource Navy}"
						                   HorizontalOptions="Center" VerticalOptions="Center" />
					</Grid>

					<HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
						<Label Text="Already have an account?" TextColor="{StaticResource TextMuted}" FontSize="14" />
						<Label Text="Login" Style="{StaticResource LinkLabel}">
							<Label.GestureRecognizers>
								<TapGestureRecognizer Tapped="OnBackTapped" />
							</Label.GestureRecognizers>
						</Label>
					</HorizontalStackLayout>
				</VerticalStackLayout>
			</Border>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
