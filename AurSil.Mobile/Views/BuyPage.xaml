<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AurSil.Mobile.Views.BuyPage"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

	<ContentPage.Resources>
		<Style x:Key="Quick" TargetType="Border">
			<Setter Property="StrokeThickness" Value="1" />
			<Setter Property="Stroke" Value="#D7DCE5" />
			<Setter Property="StrokeShape" Value="RoundRectangle 18" />
			<Setter Property="BackgroundColor" Value="White" />
			<Setter Property="Padding" Value="0,8" />
		</Style>
		<Style x:Key="Row" TargetType="Label">
			<Setter Property="TextColor" Value="{StaticResource TextMuted}" />
			<Setter Property="FontSize" Value="14" />
		</Style>
		<Style x:Key="RowValue" TargetType="Label">
			<Setter Property="TextColor" Value="{StaticResource Navy}" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="HorizontalOptions" Value="End" />
		</Style>
	</ContentPage.Resources>

	<Grid RowDefinitions="*,Auto">
		<ScrollView>
			<VerticalStackLayout>
				<!-- Header with live rate -->
				<Grid x:Name="Header" Padding="20,26,20,52" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" Background="{StaticResource GoldBrush}">
					<Label Text="←" TextColor="White" FontSize="26">
						<Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Label.GestureRecognizers>
					</Label>
					<Label x:Name="TitleLabel" Grid.Column="1" Text="Buy Gold" TextColor="White" FontSize="22" FontAttributes="Bold" Margin="12,0,0,0" />
					<Label x:Name="RateLabel" Grid.Row="1" Grid.ColumnSpan="2" Text="--" TextColor="White" FontSize="30" FontAttributes="Bold" Margin="0,16,0,0" />
					<HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="6">
						<Ellipse Fill="White" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
						<Label x:Name="LiveLabel" Text="Live price per gram (excl. GST)" TextColor="White" FontSize="12" />
					</HorizontalStackLayout>
				</Grid>

				<Border Margin="18,-34,18,16" Padding="18" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20">
					<Border.Shadow><Shadow Brush="Black" Opacity="0.12" Radius="18" Offset="0,6" /></Border.Shadow>
					<VerticalStackLayout Spacing="14">

						<!-- Rupees / grams toggle -->
						<Grid ColumnDefinitions="*,*" HeightRequest="42" BackgroundColor="#EEF1F6" Padding="3">
							<Border x:Name="ModeRupees" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource Navy}">
								<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnModeTapped" CommandParameter="inr" /></Border.GestureRecognizers>
								<Label Text="Buy in ₹" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
							</Border>
							<Border x:Name="ModeGrams" Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="Transparent">
								<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnModeTapped" CommandParameter="grams" /></Border.GestureRecognizers>
								<Label Text="Buy in grams" TextColor="{StaticResource Navy}" HorizontalOptions="Center" VerticalOptions="Center" />
							</Border>
						</Grid>

						<Border Style="{StaticResource FieldBorder}" HeightRequest="64">
							<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
								<Label x:Name="PrefixLabel" Text="₹" FontSize="26" TextColor="{StaticResource Navy}" VerticalOptions="Center" />
								<Entry x:Name="AmountEntry" Grid.Column="1" Placeholder="0" Keyboard="Numeric" FontSize="26"
								       TextColor="{StaticResource Navy}" BackgroundColor="Transparent" VerticalOptions="Center"
								       TextChanged="OnAmountChanged" />
								<Label x:Name="SuffixLabel" Grid.Column="2" Text="" FontSize="18" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
							</Grid>
						</Border>

						<Grid x:Name="QuickGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
							<Border Style="{StaticResource Quick}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnQuickTapped" CommandParameter="0" /></Border.GestureRecognizers>
								<Label x:Name="Quick0" Text="₹500" HorizontalOptions="Center" TextColor="{StaticResource Navy}" FontSize="13" /></Border>
							<Border Grid.Column="1" Style="{StaticResource Quick}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnQuickTapped" CommandParameter="1" /></Border.GestureRecognizers>
								<Label x:Name="Quick1" Text="₹1,000" HorizontalOptions="Center" TextColor="{StaticResource Navy}" FontSize="13" /></Border>
							<Border Grid.Column="2" Style="{StaticResource Quick}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnQuickTapped" CommandParameter="2" /></Border.GestureRecognizers>
								<Label x:Name="Quick2" Text="₹2,000" HorizontalOptions="Center" TextColor="{StaticResource Navy}" FontSize="13" /></Border>
							<Border Grid.Column="3" Style="{StaticResource Quick}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnQuickTapped" CommandParameter="3" /></Border.GestureRecognizers>
								<Label x:Name="Quick3" Text="₹5,000" HorizontalOptions="Center" TextColor="{StaticResource Navy}" FontSize="13" /></Border>
						</Grid>

						<!-- Breakdown -->
						<Border BackgroundColor="#F8FAFC" Stroke="#E5E7EB" StrokeShape="RoundRectangle 14" Padding="14">
							<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
								<Label Text="You get" Style="{StaticResource Row}" />
								<Label x:Name="GetLabel" Grid.Column="1" Text="0 g" Style="{StaticResource RowValue}" FontAttributes="Bold" FontSize="16" />
								<Label Grid.Row="1" Text="Rate / g" Style="{StaticResource Row}" />
								<Label x:Name="RateRow" Grid.Row="1" Grid.Column="1" Text="--" Style="{StaticResource RowValue}" />
								<Label Grid.Row="2" Text="Metal value" Style="{StaticResource Row}" />
								<Label x:Name="ValueRow" Grid.Row="2" Grid.Column="1" Text="₹0.00" Style="{StaticResource RowValue}" />
								<Label x:Name="DiscountTitle" Grid.Row="3" Text="Offer discount" Style="{StaticResource Row}" TextColor="#15803D" IsVisible="False" />
								<Label x:Name="DiscountRow" Grid.Row="3" Grid.Column="1" Text="" Style="{StaticResource RowValue}" TextColor="#15803D" IsVisible="False" />
								<Label x:Name="GstTitle" Grid.Row="4" Text="GST (3%)" Style="{StaticResource Row}" />
								<Label x:Name="GstRow" Grid.Row="4" Grid.Column="1" Text="₹0.00" Style="{StaticResource RowValue}" />
								<BoxView Grid.Row="5" Grid.ColumnSpan="2" HeightRequest="1" Color="#E5E7EB" VerticalOptions="Start" />
							</Grid>
						</Border>
						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Total payable" TextColor="{StaticResource Navy}" FontSize="16" FontAttributes="Bold" />
							<Label x:Name="TotalRow" Grid.Column="1" Text="₹0.00" TextColor="{StaticResource Navy}" FontSize="18" FontAttributes="Bold" />
						</Grid>

						<Label x:Name="ErrorLabel" TextColor="{StaticResource ErrorRed}" FontSize="13" IsVisible="False" />
						<Label Text="🔒 Your metal is stored safely and can be sold anytime at the live sell price." FontSize="12"
						       TextColor="{StaticResource TextMuted}" />
					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>
		</ScrollView>

		<Grid Grid.Row="1" Padding="18,10,18,14" BackgroundColor="White">
			<Button x:Name="PayButton" Text="Proceed to Pay" Style="{StaticResource GoldButton}" Clicked="OnPayClicked" />
			<ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" Color="{StaticResource Navy}"
			                   HorizontalOptions="Center" VerticalOptions="Center" />
		</Grid>
	</Grid>
</ContentPage>
