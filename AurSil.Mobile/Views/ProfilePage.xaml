<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AurSil.Mobile.Views.ProfilePage"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False">

	<ContentPage.Resources>
		<Style x:Key="MenuRow" TargetType="Grid">
			<Setter Property="Padding" Value="16,14" />
			<Setter Property="ColumnSpacing" Value="14" />
		</Style>
	</ContentPage.Resources>

	<ScrollView>
		<VerticalStackLayout>
			<VerticalStackLayout BackgroundColor="{StaticResource Navy}" Padding="20,30,20,60" Spacing="8">
				<Border WidthRequest="78" HeightRequest="78" StrokeThickness="0" StrokeShape="RoundRectangle 39" Background="{StaticResource GoldBrush}"
				        HorizontalOptions="Center">
					<Label x:Name="InitialLabel" Text="A" FontSize="34" FontAttributes="Bold" TextColor="{StaticResource Navy}"
					       HorizontalOptions="Center" VerticalOptions="Center" />
				</Border>
				<Label x:Name="NameLabel" Text="" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
				<Label x:Name="UserIdLabel" Text="" TextColor="#AEB8CC" FontSize="13" HorizontalOptions="Center" />
			</VerticalStackLayout>

			<Border Margin="16,-38,16,16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18">
				<Border.Shadow><Shadow Brush="Black" Opacity="0.1" Radius="16" Offset="0,6" /></Border.Shadow>
				<VerticalStackLayout>
					<Grid Style="{StaticResource MenuRow}" ColumnDefinitions="Auto,*">
						<Label Text="✉️" FontSize="20" VerticalOptions="Center" />
						<VerticalStackLayout Grid.Column="1">
							<Label Text="Email" FontSize="12" TextColor="{StaticResource TextMuted}" />
							<Label x:Name="EmailLabel" Text="" FontSize="15" TextColor="{StaticResource Navy}" />
						</VerticalStackLayout>
					</Grid>
					<BoxView HeightRequest="1" Color="#EEF1F6" />
					<Grid Style="{StaticResource MenuRow}" ColumnDefinitions="Auto,*">
						<Label Text="📱" FontSize="20" VerticalOptions="Center" />
						<VerticalStackLayout Grid.Column="1">
							<Label Text="Mobile" FontSize="12" TextColor="{StaticResource TextMuted}" />
							<Label x:Name="PhoneLabel" Text="" FontSize="15" TextColor="{StaticResource Navy}" />
						</VerticalStackLayout>
					</Grid>
					<BoxView HeightRequest="1" Color="#EEF1F6" />
					<Grid Style="{StaticResource MenuRow}" ColumnDefinitions="Auto,*,Auto">
						<Label Text="✅" FontSize="20" VerticalOptions="Center" />
						<VerticalStackLayout Grid.Column="1">
							<Label Text="Account status" FontSize="12" TextColor="{StaticResource TextMuted}" />
							<Label x:Name="StatusLabel" Text="" FontSize="15" TextColor="#15803D" FontAttributes="Bold" />
						</VerticalStackLayout>
					</Grid>
				</VerticalStackLayout>
			</Border>

			<Border Margin="16,0,16,16" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18">
				<VerticalStackLayout>
					<Grid Style="{StaticResource MenuRow}" ColumnDefinitions="Auto,*,Auto">
						<Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnBankTapped" /></Grid.GestureRecognizers>
						<Label Text="🏦" FontSize="20" VerticalOptions="Center" />
						<VerticalStackLayout Grid.Column="1">
							<Label Text="Bank Account" FontSize="15" TextColor="{StaticResource Navy}" FontAttributes="Bold" />
							<Label x:Name="BankLabel" Text="Add a bank account to receive sale money" FontSize="12" TextColor="{StaticResource TextMuted}" />
						</VerticalStackLayout>
						<Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
					</Grid>
					<BoxView HeightRequest="1" Color="#EEF1F6" />
					<Grid Style="{StaticResource MenuRow}" ColumnDefinitions="Auto,*,Auto">
						<Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnTransactionsTapped" /></Grid.GestureRecognizers>
						<Label Text="🧾" FontSize="20" VerticalOptions="Center" />
						<Label Grid.Column="1" Text="Transactions" FontSize="15" TextColor="{StaticResource Navy}" FontAttributes="Bold" VerticalOptions="Center" />
						<Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
					</Grid>
					<BoxView HeightRequest="1" Color="#EEF1F6" />
					<Grid Style="{StaticResource MenuRow}" ColumnDefinitions="Auto,*,Auto">
						<Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnServerTapped" /></Grid.GestureRecognizers>
						<Label Text="⚙️" FontSize="20" VerticalOptions="Center" />
						<VerticalStackLayout Grid.Column="1">
							<Label Text="Server address" FontSize="15" TextColor="{StaticResource Navy}" FontAttributes="Bold" />
							<Label x:Name="ServerLabel" Text="" FontSize="12" TextColor="{StaticResource TextMuted}" LineBreakMode="TailTruncation" />
						</VerticalStackLayout>
						<Label Grid.Column="2" Text="›" FontSize="24" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
					</Grid>
				</VerticalStackLayout>
			</Border>

			<Button Text="Logout" Margin="16,4,16,8" BackgroundColor="White" TextColor="{StaticResource ErrorRed}" BorderColor="#F3C4C4"
			        BorderWidth="1" CornerRadius="12" HeightRequest="50" FontAttributes="Bold" Clicked="OnLogoutClicked" />
			<Label Text="AurSil v1.0 • Prices: gold-api.com • Payments: Razorpay (test)" FontSize="11" TextColor="#9CA3AF"
			       HorizontalOptions="Center" Margin="0,4,0,24" />
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
