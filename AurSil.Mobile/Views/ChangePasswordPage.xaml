<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AurSil.Mobile.Views.ChangePasswordPage"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

	<ScrollView>
		<VerticalStackLayout>
			<Grid BackgroundColor="{StaticResource Navy}" Padding="20,28,20,56" ColumnDefinitions="Auto,*">
				<Label Text="←" TextColor="White" FontSize="26" VerticalOptions="Start">
					<Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Label.GestureRecognizers>
				</Label>
				<VerticalStackLayout Grid.Column="1" Spacing="4" Margin="12,0,0,0">
					<Label Text="Change Password" TextColor="White" FontSize="24" FontAttributes="Bold" />
					<Label Text="Use at least 8 characters with letters and numbers" TextColor="#AEB8CC" FontSize="13" />
				</VerticalStackLayout>
			</Grid>

			<Border Margin="20,-34,20,20" Padding="22" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20">
				<Border.Shadow><Shadow Brush="Black" Opacity="0.12" Radius="18" Offset="0,6" /></Border.Shadow>
				<VerticalStackLayout Spacing="12">
					<VerticalStackLayout>
						<Label Text="Current Password" Style="{StaticResource FieldLabel}" />
						<Border Style="{StaticResource FieldBorder}">
							<Entry x:Name="CurrentEntry" Placeholder="Enter current password" IsPassword="True" Style="{StaticResource FieldEntry}" />
						</Border>
					</VerticalStackLayout>
					<VerticalStackLayout>
						<Label Text="New Password" Style="{StaticResource FieldLabel}" />
						<Border Style="{StaticResource FieldBorder}">
							<Entry x:Name="NewEntry" Placeholder="At least 8 characters" IsPassword="True" Style="{StaticResource FieldEntry}" />
						</Border>
					</VerticalStackLayout>
					<VerticalStackLayout>
						<Label Text="Confirm New Password" Style="{StaticResource FieldLabel}" />
						<Border Style="{StaticResource FieldBorder}">
							<Entry x:Name="ConfirmEntry" Placeholder="Re-enter new password" IsPassword="True" Style="{StaticResource FieldEntry}"
							       ReturnType="Done" Completed="OnSaveClicked" />
						</Border>
					</VerticalStackLayout>

					<Label x:Name="ErrorLabel" TextColor="{StaticResource ErrorRed}" FontSize="13" IsVisible="False" />

					<Grid Margin="0,4,0,0">
						<Button x:Name="SaveButton" Text="Update Password" Style="{StaticResource GoldButton}" Clicked="OnSaveClicked" />
						<ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" Color="{StaticResource Navy}"
						                   HorizontalOptions="Center" VerticalOptions="Center" />
					</Grid>
				</VerticalStackLayout>
			</Border>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
