<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AurSil.Mobile.Views.PaymentPage"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

	<Grid RowDefinitions="Auto,*">
		<Grid BackgroundColor="{StaticResource Navy}" Padding="16,18" ColumnDefinitions="Auto,*">
			<Label Text="✕" TextColor="White" FontSize="22" VerticalOptions="Center">
				<Label.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseTapped" /></Label.GestureRecognizers>
			</Label>
			<Label Grid.Column="1" Text="Secure Payment" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="14,0,0,0" VerticalOptions="Center" />
		</Grid>
		<WebView x:Name="Web" Grid.Row="1" Navigating="OnNavigating" Navigated="OnNavigated" />
		<ActivityIndicator x:Name="Busy" Grid.Row="1" IsRunning="True" Color="{StaticResource Gold}"
		                   HorizontalOptions="Center" VerticalOptions="Center" />
	</Grid>
</ContentPage>
