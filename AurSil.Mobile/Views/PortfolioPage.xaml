<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:AurSil.Mobile.Services"
             x:Class="AurSil.Mobile.Views.PortfolioPage"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False">

	<RefreshView x:Name="Refresher" Refreshing="OnRefreshing" RefreshColor="{StaticResource Gold}">
		<ScrollView>
			<VerticalStackLayout>
				<!-- Summary -->
				<VerticalStackLayout BackgroundColor="{StaticResource Navy}" Padding="20,24,20,56" Spacing="4">
					<Label Text="My Investments" TextColor="White" FontSize="24" FontAttributes="Bold" />
					<Label Text="Current value" TextColor="#AEB8CC" FontSize="13" Margin="0,14,0,0" />
					<Label x:Name="ValueLabel" Text="₹0.00" TextColor="{StaticResource Gold}" FontSize="34" FontAttributes="Bold" />
					<HorizontalStackLayout Spacing="16">
						<Label x:Name="InvestedLabel" Text="Invested ₹0.00" TextColor="#AEB8CC" FontSize="13" />
						<Label x:Name="PlLabel" Text="" FontSize="13" FontAttributes="Bold" />
					</HorizontalStackLayout>
				</VerticalStackLayout>

				<!-- Holdings -->
				<VerticalStackLayout x:Name="HoldingsList" Margin="16,-36,16,0" Spacing="12" />

				<!-- Transactions -->
				<Grid ColumnDefinitions="*,Auto" Margin="20,22,20,8">
					<Label Text="Transactions" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
					<Label x:Name="TxCount" Grid.Column="1" Text="" FontSize="13" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
				</Grid>
				<Border Margin="16,0,16,24" Padding="6,4" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16">
					<VerticalStackLayout x:Name="TxList">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="svc:OrderDto">
								<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="10,12">
									<Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="#FFF4D6">
										<Label Text="{Binding Icon}" FontAttributes="Bold" TextColor="{StaticResource GoldDark}" HorizontalOptions="Center" VerticalOptions="Center" />
									</Border>
									<VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
										<Label Text="{Binding Title}" FontAttributes="Bold" TextColor="{StaticResource Navy}" FontSize="14" />
										<Label Text="{Binding GramsText}" TextColor="{StaticResource TextMuted}" FontSize="12" />
										<Label Text="{Binding DateText}" TextColor="#9CA3AF" FontSize="11" />
									</VerticalStackLayout>
									<VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
										<Label Text="{Binding TotalText}" TextColor="{Binding TotalColor}" FontAttributes="Bold" FontSize="14" HorizontalOptions="End" />
										<Label Text="{Binding Detail}" TextColor="#9CA3AF" FontSize="11" HorizontalOptions="End" />
									</VerticalStackLayout>
								</Grid>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
						<BindableLayout.EmptyView>
							<Label Text="No transactions yet. Buy your first gram today!" TextColor="{StaticResource TextMuted}"
							       HorizontalOptions="Center" Margin="0,24" />
						</BindableLayout.EmptyView>
					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>
		</ScrollView>
	</RefreshView>
</ContentPage>
