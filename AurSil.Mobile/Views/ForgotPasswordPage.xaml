<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AurSil.Mobile.Views.ForgotPasswordPage"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False">

	<ScrollView>
		<VerticalStackLayout>

			<Grid BackgroundColor="{StaticResource Navy}" Padding="20,28,20,56" ColumnDefinitions="Auto,*">
				<Label Text="←" TextColor="White" FontSize="26" VerticalOptions="Start">
					<Label.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnBackTapped" />
					</Label.GestureRecognizers>
				</Label>
				<VerticalStackLayout Grid.Column="1" Spacing="4" Margin="12,0,0,0">
					<Label Text="Forgot Password" TextColor="White" FontSize="24" FontAttributes="Bold" />
					<Label x:Name="SubtitleLabel" Text="We'll email you a one-time password" TextColor="#AEB8CC" FontSize="13" />
				</VerticalStackLayout>
			</Grid>

			<Border Margin="20,-34,20,20" Padding="22" BackgroundColor="White" StrokeThickness="0"
			        StrokeShape="RoundRectangle 20">
				<Border.Shadow>
					<Shadow Brush="Black" Opacity="0.12" Radius="18" Offset="0,6" />
				</Border.Shadow>
				<VerticalStackLayout Spacing="12">

					<!-- Step 1: email -->
					<VerticalStackLayout>
						<Label Text="Registered Email" Style="{StaticResource FieldLabel}" />
						<Border Style="{StaticResource FieldBorder}">
							<Entry x:Name="EmailEntry" Placeholder="you@example.com" Style="{StaticResource FieldEntry}"
							       Keyboard="Email" />
						</Border>
					</VerticalStackLayout>

					<!-- Step 2: OTP + new password -->
					<VerticalStackLayout x:Name="ResetSection" IsVisible="False" Spacing="12">
						<VerticalStackLayout>
							<Label Text="OTP" Style="{StaticResource FieldLabel}" />
							<Border Style="{StaticResource FieldBorder}">
								<Entry x:Name="CodeEntry" Placeholder="6-digit code" Style="{StaticResource FieldEntry}"
								       Keyboard="Numeric" MaxLength="6" />
							</Border>
						</VerticalStackLayout>
						<VerticalStackLayout>
							<Label Text="New Password" Style="{StaticResource FieldLabel}" />
							<Border Style="{StaticResource FieldBorder}">
								<Entry x:Name="NewPasswordEntry" Placeholder="Min 8 characters, letters + numbers"
								       Style="{StaticResource FieldEntry}" IsPassword="True" />
							</Border>
						</VerticalStackLayout>
						<VerticalStackLayout>
							<Label Text="Confirm New Password" Style="{StaticResource FieldLabel}" />
							<Border Style="{StaticResource FieldBorder}">
								<Entry x:Name="ConfirmEntry" Placeholder="Re-enter new password"
								       Style="{StaticResource FieldEntry}" IsPassword="True" />
							</Border>
						</VerticalStackLayout>
					</VerticalStackLayout>

					<Label x:Name="InfoLabel" TextColor="#15803D" FontSize="13" IsVisible="False" />
					<Label x:Name="ErrorLabel" TextColor="{StaticResource ErrorRed}" FontSize="13" IsVisible="False" />

					<Grid>
						<Button x:Name="ActionButton" Text="Send OTP" Style="{StaticResource GoldButton}" Clicked="OnActionClicked" />
						<ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" Color="{StaticResource Navy}"
						                   HorizontalOptions="Center" VerticalOptions="Center" />
					</Grid>

					<Label x:Name="ResendLabel" Text="Resend OTP" Style="{StaticResource LinkLabel}" HorizontalOptions="Center"
					       IsVisible="False">
						<Label.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnResendTapped" />
						</Label.GestureRecognizers>
					</Label>
				</VerticalStackLayout>
			</Border>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
