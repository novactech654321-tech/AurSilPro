<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AurSil.Mobile.Views.SplashPage"
             BackgroundColor="{StaticResource Navy}"
             Shell.NavBarIsVisible="False">

	<Grid RowDefinitions="*,Auto,Auto">
		<VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="14">
			<Image x:Name="Logo" Source="logo.png" WidthRequest="130" HeightRequest="130"
			       Opacity="0" Scale="0.6" HorizontalOptions="Center" />

			<Label x:Name="Brand" HorizontalOptions="Center" Opacity="0" FontSize="40" FontAttributes="Bold">
				<Label.FormattedText>
					<FormattedString>
						<Span Text="Aur" TextColor="{StaticResource Gold}" />
						<Span Text="Sil" TextColor="{StaticResource SilverTone}" />
					</FormattedString>
				</Label.FormattedText>
			</Label>

			<Label x:Name="Tagline" Text="Invest  |  Grow  |  Secure" Opacity="0"
			       TextColor="#AEB8CC" FontSize="15" HorizontalOptions="Center" />
		</VerticalStackLayout>

		<VerticalStackLayout Grid.Row="1" Spacing="10" Margin="0,0,0,24">
			<ActivityIndicator IsRunning="True" Color="{StaticResource Gold}"
			                   WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" />
			<Label x:Name="StatusLabel" Text="Opening AurSil..." TextColor="#AEB8CC"
			       FontSize="13" HorizontalOptions="Center" />
		</VerticalStackLayout>

		<Label Grid.Row="2" Text="Gold  •  Silver  •  Platinum" TextColor="#5E6E8C"
		       FontSize="12" HorizontalOptions="Center" Margin="0,0,0,28" />
	</Grid>
</ContentPage>
