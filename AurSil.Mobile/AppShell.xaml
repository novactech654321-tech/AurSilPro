<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AurSil.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AurSil.Mobile.Views"
    Title="AurSil"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarBackgroundColor="#071427"
    Shell.TabBarForegroundColor="#F5B82E"
    Shell.TabBarTitleColor="#F5B82E"
    Shell.TabBarUnselectedColor="#8A97B0">

    <ShellContent Route="splash" ContentTemplate="{DataTemplate views:SplashPage}" />
    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" />

    <TabBar Route="main">
        <Tab Title="Home" Icon="tab_home.png" Route="home">
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>
        <Tab Title="Market" Icon="tab_market.png" Route="market">
            <ShellContent ContentTemplate="{DataTemplate views:MarketPage}" />
        </Tab>
        <Tab Title="Portfolio" Icon="tab_portfolio.png" Route="portfolio">
            <ShellContent ContentTemplate="{DataTemplate views:PortfolioPage}" />
        </Tab>
        <Tab Title="Profile" Icon="tab_profile.png" Route="profile">
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>
    </TabBar>

</Shell>
